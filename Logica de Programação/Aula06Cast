# CONVERSAO DE TIPOS OU COERÇÃO
# CONVERTER TIPOS STRING EM OUTROS TIPOS

# PARA CONVERTER DE STRING PARA INTEIRO:
print("Transformando Textos em numeros:  ")
# Transfomando numeros em aspa (String str) em inteiro
print(int("1"), type(int("1")))

i = "2"
print(type(int(i)))
# ISSO DEIXA A OPERAÇÃO FIXA PARA NAO PRECISAR FICAR TRANSFORMANDO OS TIPOS DIRETO.
# Transformando em inteiro:
i = int(i)
print(i)
print(type(int(i)))

